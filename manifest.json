{
  "manifest_version": 3,
  "name": "TechTrain → Claude",
  "version": "1.3.0",
  "description": "TechTrainの「プロンプトを生成」をChatGPTではなくClaudeで開き、学習ログを記録します。",
  "permissions": [
    "storage",
    "webNavigation",
    "tabs",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://techtrain.dev/*",
    "https://*.techtrain.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://techtrain.dev/*",
        "https://*.techtrain.dev/*"
      ],
      "js": [
        "techtrain.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "claude.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TechTrain → Claude",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}